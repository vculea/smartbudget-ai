# URL-ul de bază al API-ului Spring Boot
VITE_API_BASE_URL=http://localhost:8080/api/v1

# true = folosește mock API local (date demo persistente în localStorage)
# false = folosește exclusiv backendul real
VITE_DEMO_MODE=false

# ID-ul clientului OAuth Google (public) pentru "Sign in with Google"; vezi secțiunea Autentificare din README
VITE_GOOGLE_CLIENT_ID=
