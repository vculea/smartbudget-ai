# Copy to .env (never commit .env). All values below are demonstration placeholders.

# MongoDB (used by docker compose). Avoid characters like @ : / ? in the password (it is placed in a URI).
MONGO_USER=smartbudget
MONGO_PASSWORD=change-me-demo-password

# Backend
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080
# Frontend (nginx) published on loopback only
FRONTEND_PORT=8081
# Only needed for the Vite dev server (npm run dev, port 5173); the Docker frontend is same-origin via nginx
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Demo data (idempotent). Set to false to start with an empty database.
SEED_ENABLED=true
# Swagger UI: always on in dev; in prod only when true
SWAGGER_ENABLED=true

# AI provider (any OpenAI-compatible chat completions API)
AI_API_KEY=sk-your-key-here
AI_MODEL=gpt-4o-mini
# Model with image input, used to read receipt photos (transactions "Completează din poză"). Empty = same as AI_MODEL.
AI_VISION_MODEL==https://api.openai.com/v1
AI_READ_TIMEOUT=30s

# --- Alternative: local Ollama (no cloud key). Uncomment these 4 lines and comment the OpenAI ones above.
# Ollama must be running on the host (ollama serve); `ollama pull llama3.1:8b` once.
# AI_BASE_URL=http://host.docker.internal:11434/v1   (from `mvn spring-boot:run` use http://localhost:11434/v1)
# AI_API_KEY=ollama            (any non-empty value; Ollama ignores it, the backend requires one)
# AI_MODEL=llama3.1:8b
# AI_VISION_MODEL=gemma4:26b   (receipt photos need a vision model: `ollama pull gemma4:26b` or llava / llama3.2-vision / qwen2.5vl)
# AI_READ_TIMEOUT=120s         (local models are slower than cloud APIs; max useful ~170s)

# For running outside Docker (mvn spring-boot:run), also available:
# MONGODB_URI=mongodb://localhost:27017/smartbudget
# SERVER_PORT=8080
# AI_JSON_MODE=true
